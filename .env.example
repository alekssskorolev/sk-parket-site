# Generate admin hash with npm run setup. Never commit .env.
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
DATA_DIR=./data
ADMIN_PASSWORD_HASH=
NODE_ENV=development
# Enable only AFTER real policy and consent documents + operator details are configured.
LEADS_ENABLED=false
# Production requires HTTPS origin, TLS reverse proxy and persistent DATA_DIR.
# Required together with LEADS_ENABLED=true; do not set before documents are reviewed.
PRIVACY_OPERATOR_CONFIRMED=no
# Enable ONLY behind a trusted reverse proxy that OVERWRITES X-Forwarded-For.
TRUST_PROXY=false
